{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/course-v2.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/course-v2.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/course-v2-data.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
    },
    {
      "source": "/course-v2.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
    },
    {
      "source": "/course-v2.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ]
}
